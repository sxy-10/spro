# 服务端口
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_ORIGIN=https://api.travel-agent.com
TRUST_PROXY=0
NODE_ENV=development

# 大模型配置（支持兼容 OpenAI / DeepSeek / 通义千问 等接口）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 工具调用模式：mock（演示模拟数据）或 real（对接高德/携程/飞常准/天气API）
TOOL_MODE=mock

# 外部服务 API Keys（真实模式下使用）
AMAP_API_KEY=
WEATHER_API_KEY=

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=travel_agent_db

# Redis 配置（组员1 · 阶段一）
# 不填这些也能跑：默认连 127.0.0.1:6379，连不上会自动降级到 MySQL，不影响登录
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 多人共享同一个 Redis 时用它隔离数据，例如 z3_
REDIS_KEY_PREFIX=
# 登录态缓存有效期（秒）
AUTH_CACHE_TTL_SECONDS=300
# 字典缓存有效期（秒）
DICT_CACHE_TTL_SECONDS=3600
