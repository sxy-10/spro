# 服务端口
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_ORIGIN=https://api.travel-agent.com
TRUST_PROXY=0
NODE_ENV=development

# 大模型配置（支持兼容 OpenAI / DeepSeek / 通义千问 等接口）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 工具调用模式：mock（演示模拟数据）或 real（对接高德/携程/飞常准/天气API）
TOOL_MODE=mock

# 外部服务 API Keys（真实模式下使用）
AMAP_API_KEY=
WEATHER_API_KEY=

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=travel_agent_db
