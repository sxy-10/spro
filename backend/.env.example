# 服务端口
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_ORIGIN=https://api.travel-agent.com
# 反代部署必须置 1：让 Express 从 X-Forwarded-For 取真实客户端 IP。
# 置 0 时 req.ip 全是 127.0.0.1，全站共用一个限流桶 —— 上线必挂。
TRUST_PROXY=1
NODE_ENV=development

# 大模型配置（DeepSeek，OpenAI 兼容协议）
# 密钥只从环境变量读取，禁止写进代码仓库；本地可写在 .env（已被 .gitignore 忽略）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认 deepseek-flash（支持思考模式）；若账号不可用会自动降级到 deepseek-chat
DEEPSEEK_MODEL=deepseek-flash
# 置 1 可临时关闭大模型，强制使用本地模板引擎
AI_DISABLED=0

# 工具调用模式：mock（演示模拟数据）或 real（对接高德/携程/飞常准/天气API）
TOOL_MODE=mock

# 外部服务 API Keys（真实模式下使用）
AMAP_API_KEY=
WEATHER_API_KEY=

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=travel_agent_db

# Redis 配置（组员1 · 阶段一）
# 不填这些也能跑：默认连 127.0.0.1:6379，连不上会自动降级到 MySQL，不影响登录
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 多人共享同一个 Redis 时用它隔离数据，例如 z3_
REDIS_KEY_PREFIX=
# 登录态缓存有效期（秒）
AUTH_CACHE_TTL_SECONDS=300
# 字典缓存有效期（秒）
DICT_CACHE_TTL_SECONDS=3600
# 建连超时（毫秒）：局域网上别人 Redis 挂了不要把你的请求拖死
REDIS_CONNECT_TIMEOUT_MS=1000
# 置 1 可彻底停用 Redis（所有缓存/限流/库存自动降级），排障时用
REDIS_DISABLED=0

# 秒杀（组员3 · 阶段二）
# 结果记录 TTL：前端只轮询 10 秒，但用户可能过一会儿再回来看
SECKILL_RESULT_TTL_SECONDS=1800
# 同一用户同一场次的提交互斥时长（秒）
SECKILL_LOCK_TTL_SECONDS=10
# Stream 保留条数 / 死信保留条数（不设上限 Redis 内存会一直涨）
SECKILL_STREAM_MAXLEN=10000
SECKILL_DLQ_MAXLEN=2000
# 消费者并发与批次
SECKILL_CONSUMER_BATCH=20
SECKILL_CONSUMER_CONCURRENCY=4
# 失败重试次数（超过就进死信 + 回补库存）
SECKILL_MAX_ATTEMPTS=3
# PEL 回收：超过这个空闲时间没 ACK 的消息会被重新认领
SECKILL_CLAIM_IDLE_MS=60000
SECKILL_RECLAIM_INTERVAL_MS=30000

# 限流（阶段六）
# 置 1 可关闭应用层限流（单测里用，保证断言可重复）
RATE_LIMIT_DISABLED=0
