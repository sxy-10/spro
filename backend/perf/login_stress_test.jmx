<?xml version="1.0" encoding="UTF-8"?>
<!--
  第四阶段 · 登录接口高并发压测（组员6）
  目的：验证高并发登录下的防刷限流机制（同一手机号/IP 高频请求是否被 429 拦截）。
  用法：
    1. JMeter 打开本文件
    2. 修改 HTTP Request Defaults 里的服务器地址为实际后端（默认 localhost:8000）
    3. 修改线程组并发数（默认 100 并发，10s 爬坡，循环 10 次 = 约 1000 次请求）
    4. 运行，看「聚合报告」+「查看结果树」中 429/20014 出现比例
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testname="登录接口高并发压测" enabled="true">
      <stringProp name="TestPlan.comments">验证登录接口在高并发下的限流/防刷行为</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testname="用户定义变量" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">8000</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- 线程组：100 并发，10 秒爬坡，每线程循环 10 次 -->
      <ThreadGroup guiclass="ThreadGroupGui" testname="登录压测线程组" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testname="循环控制器" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">10</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">100</stringProp>
        <stringProp name="ThreadGroup.ramp_time">10</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>

        <!-- HTTP 请求默认值 -->
        <ConfigTestElement guiclass="HttpDefaultsGui" testname="HTTP请求默认值" enabled="true">
          <stringProp name="HTTPSampler.domain">${BASE_URL}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/auth/login</stringProp>
        </ConfigTestElement>
        <hashTree/>

        <!-- 登录 POST 请求 -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testname="POST /auth/login" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <stringProp name="Argument.value">{&#xd;
  &quot;mobile&quot;: &quot;13800000099&quot;,&#xd;
  &quot;password&quot;: &quot;Stress@123&quot;&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- 断言：HTTP 200 或 429 都算"系统正常响应" -->
          <ResponseAssertion guiclass="AssertionGui" testname="响应状态断言" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="200">200</stringProp>
              <stringProp name="429">429</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.apply_to">1</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- 聚合报告 -->
        <ResultCollector guiclass="StatVisualizer" testname="聚合报告" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time><latency>true</time><timestamp>true</time>
              <success>true</true><label>true</true><code>true</true>
              <message>true</true><threadName>true</true><dataType>true</true>
              <encoding>false</true><assertions>true</true><subresults>false</subresults>
              <responseData>false</true><samplerData>false</samplerData>
              <xml>false</xml><fieldNames>true</fieldNames>
              <responseHeaders>false</responseHeaders><requestHeaders>false</requestHeaders>
            </value>
          </objProp>
          <stringProp name="filename"></stringProp>
        </ResultCollector>
        <hashTree/>

        <!-- 查看结果树 -->
        <ResultCollector guiclass="ViewResultsFullVisualizer" testname="查看结果树" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time><latency>true</time><timestamp>true</time>
              <success>true</true><label>true</true><code>true</code>
              <message>true</true><threadName>true</true><dataType>true</true>
              <encoding>false</true><assertions>true</true><subresults>false</subresults>
              <responseData>true</responseData><samplerData>true</samplerData>
              <xml>false</xml><fieldNames>true</fieldNames>
              <responseHeaders>false</responseHeaders><requestHeaders>false</requestHeaders>
            </value>
          </objProp>
          <stringProp name="filename"></stringProp>
        </ResultCollector>
        <hashTree/>

      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
